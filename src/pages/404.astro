---
// 404 - friendly miss page.
import Base from "@/layouts/Base.astro";
---
<Base title="Not found" description="That page doesn't exist." path="/404/">
  <div class="container">
    <section class="hero">
      <h1>Lost at sea.</h1>
      <p class="lede">That page doesn't exist - or washed overboard. Try a search, or head back to the bridge.</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </section>
  </div>
</Base>
