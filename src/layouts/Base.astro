---
// Base - shared document shell: head, header with brand + search, footer, SW.
import "@/styles/base.css";
import ToolSearch from "@/components/ToolSearch.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  title: string;
  description: string;
  /** Absolute path for the canonical URL and OG tags, e.g. "/tools/pdf/merge/". */
  path?: string;
}
const { title, description, path = "/" } = Astro.props;
const site = new URL(Astro.site ?? "https://mr.tools");
const canonical = new URL(path, site);
const pageTitle = title;
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("theme");
          var dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.dataset.theme = "dark";
        } catch (e) {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#5a5bd9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mr.tools" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <span class="brand-mark">mr</span>
          <span class="brand-name">mr.tools</span>
        </a>
        <ToolSearch />
        <button
          class="theme-toggle"
          data-theme-toggle
          type="button"
          aria-label="Switch to dark theme"
          title="Toggle theme"
        >
          <Icon name="sun" size={18} class="theme-sun" />
          <Icon name="moon" size={18} class="theme-moon" />
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>mr.tools - tiny tools that run entirely in your browser. Nothing leaves your device.</span>
        <span class="footer-links">
          <span>Privacy first · No uploads, no accounts</span>
          <a class="github-link" href="https://github.com/mrxerp/mr.tools" target="_blank" rel="noopener" aria-label="Source code on GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.8-.3-5.7-1.4-5.7-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.9 5.7-5.7 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>
            <span>Open source</span>
          </a>
        </span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      toggle?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        if (next === "dark") root.dataset.theme = "dark";
        else delete root.dataset.theme;
        try {
          localStorage.setItem("theme", next);
        } catch (e) {}
        toggle.setAttribute("aria-label", next === "dark" ? "Switch to light theme" : "Switch to dark theme");
      });
    </script>

    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>
  </body>
</html>
