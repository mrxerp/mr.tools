---
---
<section class="stage">
  <div class="drop-zone" data-zone tabindex="0" role="button">
    <input type="file" accept="image/*" data-file hidden />
    <div class="dz-title">Drop an image or click to browse</div>
    <div class="dz-hint">PNG, JPEG, or WebP — nothing uploads.</div>
  </div>

  <div class="grid" data-controls style="display:none;grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
    <label class="field">
      <span class="field-label">Compression level</span>
      <select class="input" data-level>
        <option value="balanced">Balanced</option>
        <option value="smaller">Smaller</option>
        <option value="smallest">Smallest</option>
      </select>
    </label>
  </div>

  <div class="grid" data-preview style="display:none;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
    <figure>
      <figcaption class="field-label">Original</figcaption>
      <img data-before alt="Original image" />
    </figure>
    <figure>
      <figcaption class="field-label">Compressed</figcaption>
      <img data-after alt="Compressed image" />
    </figure>
  </div>

  <div class="actions">
    <button class="btn btn-primary" type="button" data-download disabled>Download</button>
  </div>
  <p class="error-text" data-error style="display:none"></p>
  <output class="output-box" data-out aria-live="polite" style="display:none"></output>
</section>

<style>
  figure {
    margin: 0;
  }
  figure img {
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { qualityForLevel, percentSaved } from "./tool.ts";
  import { loadImageBitmap, drawScaled, canvasToBlob } from "../_lib.ts";
  import { formatBytes, swapExtension } from "@/lib/files";
  import { downloadBlob } from "@/lib/download";

  const zone = document.querySelector<HTMLDivElement>("[data-zone]")!;
  const fileInput = document.querySelector<HTMLInputElement>("[data-file]")!;
  const levelSelect = document.querySelector<HTMLSelectElement>("[data-level]")!;
  const controls = document.querySelector<HTMLDivElement>("[data-controls]")!;
  const preview = document.querySelector<HTMLDivElement>("[data-preview]")!;
  const beforeImg = document.querySelector<HTMLImageElement>("[data-before]")!;
  const afterImg = document.querySelector<HTMLImageElement>("[data-after]")!;
  const downloadBtn = document.querySelector<HTMLButtonElement>("[data-download]")!;
  const errorEl = document.querySelector<HTMLParagraphElement>("[data-error]")!;
  const outBox = document.querySelector<HTMLOutputElement>("[data-out]")!;

  let bitmap: ImageBitmap | null = null;
  let fileName = "";
  let origSize = 0;
  let origW = 0;
  let origH = 0;
  let srcType = "";
  let outType = "jpeg";
  let currentBlob: Blob | null = null;
  let beforeUrl = "";
  let afterUrl = "";
  const canvas = document.createElement("canvas");

  zone.addEventListener("click", () => fileInput.click());
  zone.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fileInput.click();
    }
  });
  fileInput.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) load(file);
    fileInput.value = "";
  });
  zone.addEventListener("dragover", (e) => {
    e.preventDefault();
    zone.classList.add("drag");
  });
  zone.addEventListener("dragleave", () => zone.classList.remove("drag"));
  zone.addEventListener("drop", (e) => {
    e.preventDefault();
    zone.classList.remove("drag");
    const file = e.dataTransfer?.files?.[0];
    if (file) load(file);
  });

  function setError(msg: string) {
    errorEl.textContent = msg;
    errorEl.style.display = msg ? "block" : "none";
  }

  async function load(file: File) {
    setError("");
    try {
      const img = await loadImageBitmap(file);
      bitmap = img.bitmap;
      fileName = file.name;
      origSize = file.size;
      origW = img.width;
      origH = img.height;
      srcType = file.type;
      outType = srcType === "image/webp" ? "webp" : "jpeg";
      if (beforeUrl) URL.revokeObjectURL(beforeUrl);
      beforeUrl = URL.createObjectURL(file);
      beforeImg.src = beforeUrl;
      controls.style.display = "";
      preview.style.display = "";
      await render();
    } catch {
      setError("Could not read that file as an image.");
    }
  }

  async function render() {
    if (!bitmap) return;
    setError("");
    drawScaled(canvas, bitmap, origW, origH);
    const quality = qualityForLevel(levelSelect.value);
    currentBlob = await canvasToBlob(canvas, `image/${outType}`, quality);
    if (afterUrl) URL.revokeObjectURL(afterUrl);
    afterUrl = URL.createObjectURL(currentBlob);
    afterImg.src = afterUrl;
    const pct = percentSaved(origSize, currentBlob.size);
    const cls = pct > 0 ? "ok-text" : pct < 0 ? "error-text" : "";
    const badge =
      cls === "" ? `${pct}%` : `<span class="${cls}">${pct > 0 ? `${pct}% saved` : `${-pct}% larger`}</span>`;
    const note =
      srcType === "image/png"
        ? "PNG re-encoding rarely shrinks a file — this image was converted to JPEG instead."
        : "Compression is lossy — quality drops as the file shrinks.";
    outBox.innerHTML = `<div>Original ${formatBytes(origSize)} → ${formatBytes(currentBlob.size)} · ${badge}</div><div class="muted">${note}</div>`;
    outBox.style.display = "block";
    downloadBtn.disabled = false;
  }

  levelSelect.addEventListener("change", render);

  downloadBtn.addEventListener("click", () => {
    if (!currentBlob) return;
    downloadBlob(currentBlob, swapExtension(fileName, outType === "webp" ? "webp" : "jpg"));
  });
</script>
