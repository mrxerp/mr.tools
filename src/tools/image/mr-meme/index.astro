---
---
<section class="stage">
  <div class="drop-zone" data-zone tabindex="0" role="button">
    <input type="file" accept="image/*" data-file hidden />
    <div class="dz-title">Drop an image or click to browse</div>
    <div class="dz-hint">PNG, JPEG, or WebP — nothing uploads.</div>
  </div>

  <div class="grid" data-controls style="display:none;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
    <label class="field">
      <span class="field-label">Top text</span>
      <input class="input" type="text" maxlength="120" placeholder="TOP CAPTION" data-top />
    </label>
    <label class="field">
      <span class="field-label">Bottom text</span>
      <input class="input" type="text" maxlength="120" placeholder="BOTTOM CAPTION" data-bottom />
    </label>
    <label class="field">
      <span class="field-label">Font size: <span data-size-value>72</span>px (auto-fits)</span>
      <input class="input" type="range" min="24" max="180" step="1" value="72" data-size />
    </label>
  </div>

  <figure data-preview style="display:none">
    <figcaption class="field-label" data-label>Preview</figcaption>
    <img data-out alt="Meme preview" />
  </figure>

  <div class="actions">
    <button class="btn btn-primary" type="button" data-download disabled>Download PNG</button>
  </div>
  <p class="error-text" data-error style="display:none"></p>
</section>

<style>
  figure {
    margin: 0;
  }
  figure img {
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
</style>

<script>
  import { memeText, wrapLines, fitFontSize, textBlockHeight } from "./tool.ts";
  import { loadImageBitmap, canvasToBlob } from "../_lib.ts";
  import { swapExtension } from "@/lib/files";
  import { downloadBlob } from "@/lib/download";

  const zone = document.querySelector<HTMLDivElement>("[data-zone]")!;
  const fileInput = document.querySelector<HTMLInputElement>("[data-file]")!;
  const topInput = document.querySelector<HTMLInputElement>("[data-top]")!;
  const bottomInput = document.querySelector<HTMLInputElement>("[data-bottom]")!;
  const sizeInput = document.querySelector<HTMLInputElement>("[data-size]")!;
  const sizeValue = document.querySelector<HTMLSpanElement>("[data-size-value]")!;
  const controls = document.querySelector<HTMLDivElement>("[data-controls]")!;
  const preview = document.querySelector<HTMLElement>("[data-preview]")!;
  const outImg = document.querySelector<HTMLImageElement>("[data-out]")!;
  const label = document.querySelector<HTMLElement>("[data-label]")!;
  const downloadBtn = document.querySelector<HTMLButtonElement>("[data-download]")!;
  const errorEl = document.querySelector<HTMLParagraphElement>("[data-error]")!;

  let bitmap: ImageBitmap | null = null;
  let fileName = "";
  let width = 0;
  let height = 0;
  let currentBlob: Blob | null = null;
  let outUrl = "";
  const canvas = document.createElement("canvas");
  const ctx = canvas.getContext("2d")!;

  zone.addEventListener("click", () => fileInput.click());
  zone.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fileInput.click();
    }
  });
  fileInput.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) load(file);
    fileInput.value = "";
  });
  zone.addEventListener("dragover", (e) => {
    e.preventDefault();
    zone.classList.add("drag");
  });
  zone.addEventListener("dragleave", () => zone.classList.remove("drag"));
  zone.addEventListener("drop", (e) => {
    e.preventDefault();
    zone.classList.remove("drag");
    const file = e.dataTransfer?.files?.[0];
    if (file) load(file);
  });

  function setError(msg: string) {
    errorEl.textContent = msg;
    errorEl.style.display = msg ? "block" : "none";
  }

  async function load(file: File) {
    setError("");
    try {
      const img = await loadImageBitmap(file);
      bitmap = img.bitmap;
      fileName = file.name;
      width = img.width;
      height = img.height;
      controls.style.display = "";
      preview.style.display = "";
      await render();
    } catch {
      setError("Could not read that file as an image.");
    }
  }

  function drawText(lines: string[], y: number, size: number) {
    if (lines.length === 0) return;
    ctx.font = `900 ${size}px Impact, "Arial Black", sans-serif`;
    ctx.textAlign = "center";
    ctx.textBaseline = "top";
    ctx.lineWidth = Math.max(2, size / 14);
    ctx.lineJoin = "round";
    ctx.strokeStyle = "#000";
    ctx.fillStyle = "#fff";
    const gap = size * 0.1;
    for (const [i, line] of lines.entries()) {
      const ly = y + i * (size + gap);
      ctx.strokeText(line, width / 2, ly);
      ctx.fillText(line, width / 2, ly);
    }
  }

  async function render() {
    if (!bitmap) return;
    const requested = sizeInput.valueAsNumber;
    const topLines = wrapLines(memeText(topInput.value), Math.max(2, Math.floor(width / (requested * 0.58))));
    const bottomLines = wrapLines(memeText(bottomInput.value), Math.max(2, Math.floor(width / (requested * 0.58))));
    const size = fitFontSize(width, [...topLines, ...bottomLines], requested);
    sizeValue.textContent = String(size);

    canvas.width = width;
    canvas.height = height;
    ctx.drawImage(bitmap, 0, 0, width, height);

    const pad = Math.round(size * 0.2);
    drawText(topLines, pad, size);
    if (bottomLines.length > 0) {
      const blockH = textBlockHeight(bottomLines, size, 0.1);
      drawText(bottomLines, height - pad - blockH, size);
    }

    currentBlob = await canvasToBlob(canvas, "image/png");
    if (outUrl) URL.revokeObjectURL(outUrl);
    outUrl = URL.createObjectURL(currentBlob);
    outImg.src = outUrl;
    label.textContent = `${width}×${height} — ${topLines.length} top line(s), ${bottomLines.length} bottom line(s)`;
    downloadBtn.disabled = false;
  }

  topInput.addEventListener("input", render);
  bottomInput.addEventListener("input", render);
  sizeInput.addEventListener("input", render);

  downloadBtn.addEventListener("click", () => {
    if (!currentBlob) return;
    downloadBlob(currentBlob, swapExtension(fileName, "png"));
  });
</script>
