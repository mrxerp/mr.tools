---
---
<section class="stage">
  <div class="drop-zone" data-zone tabindex="0" role="button" aria-label="Choose CSV or XLSX file to sort">
    <input type="file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" data-input hidden />
    <span class="dz-title">Drop a CSV or XLSX file here or click to browse</span>
    <span class="dz-hint">Multi-key sort, filter rows, reorder columns — instant preview.</span>
  </div>

  <fieldset class="field" data-options style="display:none;margin-top:1rem">
    <legend class="field-label">Sort & filter</legend>

    <div data-sort-section>
      <div class="field-label" style="margin-bottom:0.3rem">Sort by (add multiple for multi-key sort)</div>
      <div data-sort-list style="display:grid;gap:0.3rem"></div>
      <button type="button" class="btn" data-add-sort style="margin-top:0.3rem">Add sort key</button>
    </div>

    <div data-filter-section style="margin-top:1rem">
      <div class="field-label" style="margin-bottom:0.3rem">Filters</div>
      <div data-filter-list style="display:grid;gap:0.3rem"></div>
      <button type="button" class="btn" data-add-filter style="margin-top:0.3rem">Add filter</button>
    </div>

    <div data-reorder-section style="margin-top:1rem">
      <div class="field-label" style="margin-bottom:0.3rem">Column order (drag to reorder, click to toggle)</div>
      <div data-reorder-list style="display:flex;flex-wrap:wrap;gap:0.3rem;max-height:150px;overflow:auto;border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.5rem"></div>
    </div>

    <label style="display:flex;align-items:center;gap:0.5rem;margin:0.5rem 0">
      <input type="checkbox" checked data-include-header /> Include header row
    </label>

    <label style="display:flex;align-items:center;gap:0.5rem;margin:0.5rem 0">
      <span style="width:100px">Output:</span>
      <select class="input" data-format style="flex:1;max-width:200px">
        <option value="csv">CSV</option>
        <option value="xlsx">XLSX</option>
      </select>
    </label>
  </fieldset>

  <div class="actions" style="margin-top:1rem">
    <button type="button" class="btn btn-primary" data-run disabled>Apply sort & filter</button>
    <button type="button" class="btn" data-download-csv hidden>Download CSV</button>
    <button type="button" class="btn" data-download-xlsx hidden>Download XLSX</button>
  </div>

  <output class="output-box" data-out aria-live="polite"></output>

  <details data-preview style="margin-top:1rem">
    <summary class="field-label" style="cursor:pointer">Preview (first 50 rows)</summary>
    <div style="overflow:auto;max-height:300px;border:1px solid var(--border);border-radius:var(--radius-sm)" data-preview-content></div>
  </details>
</section>

<style>
  .sort-key-row { display:flex;gap:0.5rem;align-items:center; }
  .sort-key-row select { flex:1;max-width:180px; }
  .filter-row { display:flex;gap:0.5rem;align-items:center; }
  .filter-row select { flex:1;max-width:140px; }
  .filter-row input { flex:1;max-width:160px; }
  .col-pill {
    display:inline-flex;align-items:center;gap:0.3rem;padding:0.2rem 0.5rem;
    background:var(--accent-soft);color:var(--accent);border-radius:999px;font-size:0.8rem;
    cursor:grab;user-select:none;
  }
  .col-pill.active { background:var(--accent);color:var(--accent-ink); }
  .col-pill input { display:none; }
  .sort-grid { display:grid;gap:0;font-family:var(--mono);font-size:0.8rem; }
  .sort-header { background:var(--accent-soft);font-weight:600; }
  .sort-cell { padding:0.2rem 0.4rem;border:1px solid var(--border);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px; }
</style>

<script>
  import { sortAndFilter, generateSortPreview } from "./tool.ts";
  import { readFileAsArrayBuffer, readFileAsText, formatBytes, swapExtension, fileNameOf } from "@/lib/files";
  import { downloadText, downloadArrayBuffer } from "@/lib/download";

  const zone = document.querySelector<HTMLDivElement>("[data-zone]");
  const input = document.querySelector<HTMLInputElement>("[data-input]");
  const opts = document.querySelector<HTMLFieldSetElement>("[data-options]");
  const run = document.querySelector<HTMLButtonElement>("[data-run]");
  const dlCsv = document.querySelector<HTMLButtonElement>("[data-download-csv]");
  const dlXlsx = document.querySelector<HTMLButtonElement>("[data-download-xlsx]");
  const out = document.querySelector<HTMLElement>("[data-out]");
  const preview = document.querySelector<HTMLDivElement>("[data-preview-content]");
  const sortList = document.querySelector<HTMLDivElement>("[data-sort-list]");
  const filterList = document.querySelector<HTMLDivElement>("[data-filter-list]");
  const reorderList = document.querySelector<HTMLDivElement>("[data-reorder-list]");
  const addSort = document.querySelector<HTMLButtonElement>("[data-add-sort]");
  const addFilter = document.querySelector<HTMLButtonElement>("[data-add-filter]");
  const formatSel = document.querySelector<HTMLSelectElement>("[data-format]");
  const headerChk = document.querySelector<HTMLInputElement>("[data-include-header]");

  if (!zone || !input || !opts || !run || !dlCsv || !dlXlsx || !out || !preview ||
      !sortList || !filterList || !reorderList || !addSort || !addFilter || !formatSel || !headerChk) {
    throw new Error("mr sort mount failed");
  }

  const OPERATORS = [
    { value: "contains", label: "Contains" },
    { value: "eq", label: "Equals" },
    { value: "ne", label: "Not equals" },
    { value: "starts-with", label: "Starts with" },
    { value: "ends-with", label: "Ends with" },
    { value: "greater", label: "Greater than" },
    { value: "less", label: "Less than" },
  ];

  let file: File | null = null;
  let isXlsx = false;
  let headers: string[] = [];
  let lastResult: ReturnType<typeof sortAndFilter> | null = null;
  let lastXlsx: Uint8Array | null = null;
  let sortCount = 0;
  let filterCount = 0;

  const buildReorderUI = () => {
    reorderList.innerHTML = "";
    for (const h of headers) {
      const wrap = document.createElement("label");
      wrap.className = "col-pill active";
      wrap.style.cursor = "grab";
      wrap.innerHTML = `<input type="checkbox" value="${h}" checked data-reorder="${h}" style="display:none" />${h}`;
      const checkbox = wrap.querySelector<HTMLInputElement>('input');
      checkbox!.addEventListener("change", () => {
        wrap.classList.toggle("active", checkbox!.checked);
      });
      reorderList.appendChild(wrap);
    }
  };

  const addSortRow = (col = "", dir = "asc") => {
    const id = sortCount++;
    const row = document.createElement("div");
    row.className = "sort-key-row";
    row.innerHTML = `
      <select class="input" data-sort-col-${id}>
        <option value="">— Select column —</option>
        ${headers.map(h => `<option value="${h}" ${h === col ? "selected" : ""}>${h}</option>`).join("")}
      </select>
      <select class="input" data-sort-dir-${id} style="max-width:100px">
        <option value="asc" ${dir === "asc" ? "selected" : ""}>Asc</option>
        <option value="desc" ${dir === "desc" ? "selected" : ""}>Desc</option>
      </select>
      <button type="button" class="btn" data-sort-remove-${id} style="padding:0.3rem 0.6rem;font-size:0.8rem">Remove</button>
    `;
    sortList.appendChild(row);
    row.querySelector(`[data-sort-remove-${id}]`)!.addEventListener("click", () => row.remove());
  };

  const addFilterRow = (col = "", op = "contains", val = "") => {
    const id = filterCount++;
    const row = document.createElement("div");
    row.className = "filter-row";
    row.innerHTML = `
      <select class="input" data-filter-col-${id}>
        <option value="">— Select column —</option>
        ${headers.map(h => `<option value="${h}" ${h === col ? "selected" : ""}>${h}</option>`).join("")}
      </select>
      <select class="input" data-filter-op-${id} style="max-width:140px">
        ${OPERATORS.map(o => `<option value="${o.value}" ${o.value === op ? "selected" : ""}>${o.label}</option>`).join("")}
      </select>
      <input type="text" class="input" data-filter-val-${id} placeholder="Value" value="${val}" />
      <button type="button" class="btn" data-filter-remove-${id} style="padding:0.3rem 0.6rem;font-size:0.8rem">Remove</button>
    `;
    filterList.appendChild(row);
    row.querySelector(`[data-filter-remove-${id}]`)!.addEventListener("click", () => row.remove());
  };

  const getOptions = () => {
    const sortBy: { column: string; direction: "asc" | "desc" }[] = [];
    for (let i = 0; i < sortCount; i++) {
      const colSel = sortList.querySelector<HTMLSelectElement>(`[data-sort-col-${i}]`);
      const dirSel = sortList.querySelector<HTMLSelectElement>(`[data-sort-dir-${i}]`);
      if (colSel && colSel.value && dirSel) {
        sortBy.push({ column: colSel.value, direction: dirSel.value as "asc" | "desc" });
      }
    }
    const filters: { column: string; operator: "eq" | "ne" | "contains" | "greater" | "less" | "starts-with" | "ends-with"; value: string }[] = [];
    for (let i = 0; i < filterCount; i++) {
      const colSel = filterList.querySelector<HTMLSelectElement>(`[data-filter-col-${i}]`);
      const opSel = filterList.querySelector<HTMLSelectElement>(`[data-filter-op-${i}]`);
      const valInp = filterList.querySelector<HTMLInputElement>(`[data-filter-val-${i}]`);
      if (colSel && colSel.value && opSel && valInp) {
        filters.push({ column: colSel.value, operator: opSel.value as any, value: valInp.value });
      }
    }
    const reorderColumns: string[] = [];
    for (const checkbox of reorderList.querySelectorAll<HTMLInputElement>('input[data-reorder]')) {
      if (checkbox.checked) reorderColumns.push(checkbox.value);
    }
    return { sortBy, filters, reorderColumns, includeHeader: headerChk.checked };
  };

  const renderPreview = (result: ReturnType<typeof sortAndFilter>) => {
    const maxRows = 50;
    const displayRows = result.rows.slice(0, maxRows);
    let html = `<table class="sort-grid" style="border-collapse:collapse;width:100%"><thead><tr>`;
    for (const h of result.headers) {
      html += `<th class="sort-cell sort-header">${h}</th>`;
    }
    html += `</tr></thead><tbody>`;
    for (const row of displayRows) {
      html += `<tr>`;
      for (const cell of row) {
        html += `<td class="sort-cell">${cell}</td>`;
      }
      html += `</tr>`;
    }
    html += `</tbody></table>`;
    if (result.rows.length > maxRows) {
      html += `<div class="muted" style="padding:0.5rem">Showing ${maxRows} of ${result.rows.length} rows.</div>`;
    }
    preview.innerHTML = html;
  };

  const addFile = async (f: File) => {
    file = f;
    isXlsx = f.name.toLowerCase().endsWith(".xlsx") || f.type.includes("spreadsheetml");
    opts.style.display = "";
    run.disabled = false;
    out.textContent = `Ready: ${f.name} (${formatBytes(f.size)})`;
    preview.innerHTML = "";
    dlCsv.hidden = dlXlsx.hidden = true;
    lastResult = null;
    lastXlsx = null;
    sortList.innerHTML = "";
    filterList.innerHTML = "";
    sortCount = 0;
    filterCount = 0;

    try {
      if (isXlsx) {
        const buf = await readFileAsArrayBuffer(f);
        const XLSX = await import("xlsx");
        const wb = XLSX.read(buf, { type: "array" });
        const ws = wb.Sheets[wb.SheetNames[0]];
        const json = XLSX.utils.sheet_to_json(ws, { header: 1, defval: "" }) as string[][];
        headers = json[0] || [];
      } else {
        const text = await readFileAsText(f);
        const lines = text.split(/\r?\n/);
        const firstLine = lines[0] || "";
        const delim = [",", "\t", ";", "|"].find(d => firstLine.includes(d)) || ",";
        headers = firstLine.split(delim).map(h => h.replace(/^"|"$/g, "").trim());
      }
      buildReorderUI();
      addSortRow();
      addFilterRow();
    } catch {
      out.innerHTML = '<div class="error-text">Failed to read file.</div>';
      run.disabled = true;
    }
  };

  const doSort = async () => {
    if (!file) return;
    run.disabled = true;
    out.textContent = "Sorting & filtering…";
    try {
      let data: string;
      if (isXlsx) {
        const buf = await readFileAsArrayBuffer(file);
        const XLSX = await import("xlsx");
        const wb = XLSX.read(buf, { type: "array" });
        const ws = wb.Sheets[wb.SheetNames[0]];
        const json = XLSX.utils.sheet_to_json(ws, { header: 1, defval: "" }) as string[][];
        data = json.map(r => r.join(",")).join("\n");
      } else {
        data = await readFileAsText(file);
      }

      const options = getOptions();
      lastResult = sortAndFilter(data, options);

      if (formatSel.value === "xlsx") {
        const XLSX = await import("xlsx");
        const wb = XLSX.utils.book_new();
        const ws = XLSX.utils.aoa_to_sheet([lastResult.headers, ...lastResult.rows]);
        XLSX.utils.book_append_sheet(wb, ws, "Sorted");
        lastXlsx = XLSX.write(wb, { type: "array", bookType: "xlsx" });
        out.textContent = `Done: ${lastResult.stats.filteredRows} rows (${lastResult.stats.totalRows} original) · XLSX ${formatBytes(lastXlsx!.length)}`;
      } else {
        out.textContent = `Done: ${lastResult.stats.filteredRows} rows (${lastResult.stats.totalRows} original)`;
      }
      renderPreview(lastResult);
      dlCsv.hidden = dlXlsx.hidden = false;
    } catch (err) {
      out.innerHTML = "";
      const errEl = document.createElement("div");
      errEl.className = "error-text";
      errEl.textContent = err instanceof Error ? err.message : "Sort failed.";
      out.appendChild(errEl);
    } finally {
      run.disabled = !file;
    }
  };

  zone.addEventListener("click", () => input.click());
  zone.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); input.click(); } });
  input.addEventListener("change", () => { if (input.files?.[0]) addFile(input.files[0]); input.value = ""; });
  zone.addEventListener("dragover", (e) => { e.preventDefault(); zone.classList.add("drag"); });
  zone.addEventListener("dragleave", () => zone.classList.remove("drag"));
  zone.addEventListener("drop", (e) => { e.preventDefault(); zone.classList.remove("drag"); if (e.dataTransfer?.files?.[0]) addFile(e.dataTransfer.files[0]); });

  addSort.addEventListener("click", () => addSortRow());
  addFilter.addEventListener("click", () => addFilterRow());

  run.addEventListener("click", doSort);

  dlCsv.addEventListener("click", () => {
    if (lastResult && file) downloadText(generateSortPreview(lastResult), swapExtension(fileNameOf(file), "csv"), "text/csv");
  });

  dlXlsx.addEventListener("click", () => {
    if (lastXlsx && file) downloadArrayBuffer(lastXlsx, swapExtension(fileNameOf(file), "xlsx"), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
  });
</script>