---
// mr.frontmatter — validate/repair YAML front matter in markdown files.
---
<section class="stage">
  <label class="field">
    <span class="field-label">Paste markdown with front matter</span>
    <textarea class="input" rows="12" placeholder="---\ntitle: My Post\ndate: 2024-01-15\ntags: [tag1, tag2]\n---\n\nContent here…" data-input></textarea>
  </label>
  <div class="actions">
    <button class="btn btn-primary" data-fix>Fix Front Matter</button>
    <button class="btn" data-copy>Copy Fixed</button>
    <button class="btn" data-batch>Batch Process Folder</button>
  </div>
  <div class="output-box" data-output aria-live="polite"></div>
  <div data-warnings class="error-text" style="margin-top:0.5rem"></div>
  <div data-filename class="muted" style="margin-top:0.5rem;font-size:0.9rem"></div>
</section>

<script>
  import { fixFrontMatter, batchFix } from "./tool.ts";
  import { copyTextWithFeedback } from "@/lib/clipboard";
  import { downloadText } from "@/lib/download";

  const input = document.querySelector<HTMLTextAreaElement>("[data-input]")!;
  const output = document.querySelector<HTMLDivElement>("[data-output]")!;
  const warnings = document.querySelector<HTMLDivElement>("[data-warnings]")!;
  const filenameEl = document.querySelector<HTMLDivElement>("[data-filename]")!;

  document.querySelector("[data-fix]")!.addEventListener("click", () => {
    const result = fixFrontMatter(input.value);
    output.textContent = result.fixed;
    warnings.textContent = result.warnings.length ? "Warnings: " + result.warnings.join("; ") : "";
    if (result.suggestedFilename) {
      filenameEl.textContent = `Suggested filename: ${result.suggestedFilename}`;
    } else {
      filenameEl.textContent = "";
    }
  });

  document.querySelector("[data-copy]")!.addEventListener("click", () => {
    copyTextWithFeedback(output.textContent, document.querySelector("[data-copy]") as HTMLButtonElement);
  });

  document.querySelector("[data-batch]")!.addEventListener("click", async () => {
    const handle = await (window as unknown as { showDirectoryPicker: () => Promise<FileSystemDirectoryHandle> }).showDirectoryPicker();
    const files: Array<{ name: string; content: string }> = [];
    for await (const [, entry] of handle.entries()) {
      if (entry.kind === "file" && entry.name.endsWith(".md")) {
        const file = await (entry as FileSystemFileHandle).getFile();
        const content = await file.text();
        files.push({ name: entry.name, content });
      }
    }
    const results = batchFix(files);
    const report = results.map(({ name, result }) =>
      `=== ${name} ===
${result.warnings.length ? "Warnings: " + result.warnings.join("; ") : "OK"}
${result.suggestedFilename ? `Suggested rename: ${result.suggestedFilename}` : ""}
`).join("\n");
    output.textContent = report;
    warnings.textContent = "";
  });
</script>