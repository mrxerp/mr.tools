<section class="stage">
  <div class="drop-zone" data-zone tabindex="0" role="button" aria-label="Choose a PDF to wash">
    <input type="file" accept="application/pdf" data-input hidden />
    <span class="dz-title">Drop a PDF here or click to browse</span>
    <span class="dz-hint">One PDF — replace the pages you name with blank ones before sharing.</span>
  </div>

  <label class="field">
    <span class="field-label">Pages to blank (e.g. 3 or 5-7)</span>
    <input class="input" type="text" data-pages placeholder="3,5-7" />
  </label>

  <div class="actions">
    <button type="button" class="btn btn-primary" data-run disabled>Wash pages</button>
    <button type="button" class="btn" data-download hidden>Download washed PDF</button>
  </div>

  <output class="output-box" data-out aria-live="polite"></output>
</section>

<script>
  import { washPages, parsePageList, pdfPageCount } from "./tool.ts";
  import { readFileAsArrayBuffer, formatBytes, swapExtension } from "@/lib/files";
  import { downloadArrayBuffer } from "@/lib/download";

  const zone = document.querySelector<HTMLDivElement>("[data-zone]");
  const input = document.querySelector<HTMLInputElement>("[data-input]");
  const pagesInput = document.querySelector<HTMLInputElement>("[data-pages]");
  const run = document.querySelector<HTMLButtonElement>("[data-run]");
  const download = document.querySelector<HTMLButtonElement>("[data-download]");
  const out = document.querySelector<HTMLElement>("[data-out]");
  if (!zone || !input || !pagesInput || !run || !download || !out) throw new Error("mr page wash mount failed");

  let file: File | null = null;

  const accept = (incoming: FileList | File[]) => {
    file = Array.from(incoming).find(
      (f) => f.type === "application/pdf" || f.name.toLowerCase().endsWith(".pdf"),
    ) ?? null;
    run.disabled = !file;
    out.textContent = file ? `Loaded ${file.name} (${formatBytes(file.size)}).` : "";
  };

  zone.addEventListener("click", () => input.click());
  zone.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      input.click();
    }
  });
  input.addEventListener("change", () => {
    if (input.files) accept(input.files);
    input.value = "";
  });
  zone.addEventListener("dragover", (e) => {
    e.preventDefault();
    zone.classList.add("drag");
  });
  zone.addEventListener("dragleave", () => zone.classList.remove("drag"));
  zone.addEventListener("drop", (e) => {
    e.preventDefault();
    zone.classList.remove("drag");
    if (e.dataTransfer) accept(e.dataTransfer.files);
  });

  let washed: Uint8Array | null = null;
  run.addEventListener("click", async () => {
    if (!file) return;
    run.disabled = true;
    out.textContent = "Washing…";
    try {
      const bytes = await readFileAsArrayBuffer(file);
      const targets = parsePageList(pagesInput.value, await pdfPageCount(bytes));
      washed = await washPages(bytes, targets);
      out.textContent = `Blanked page${targets.length === 1 ? "" : "s"} ${targets.join(", ")} — ${formatBytes(washed.byteLength)}.`;
      download.hidden = false;
    } catch (err) {
      out.innerHTML = "";
      const errEl = document.createElement("div");
      errEl.className = "error-text";
      errEl.textContent = err instanceof Error ? err.message : "Wash failed.";
      out.appendChild(errEl);
    } finally {
      run.disabled = !file;
    }
  });

  download.addEventListener("click", () => {
    if (washed && file) downloadArrayBuffer(washed, swapExtension(file.name, "pdf"), "application/pdf");
  });
</script>
