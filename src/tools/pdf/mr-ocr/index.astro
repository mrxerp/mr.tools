---
// mr ocr - read the searchable text layer out of a PDF (honest scaffold: no true OCR yet).
---
<section class="stage">
  <div class="drop-zone" data-zone role="button" tabindex="0">
    <div class="dz-title">Drop a PDF here or click to browse</div>
    <div class="dz-hint">Runs locally - nothing uploads</div>
    <input type="file" accept="application/pdf" hidden data-input />
  </div>
  <div class="actions">
    <button class="btn btn-primary" data-run disabled>Extract</button>
  </div>
  <output class="output-box" data-out aria-live="polite"></output>
  <div class="results" data-results hidden>
    <div class="actions">
      <button class="btn" type="button" data-copy-all>Copy all text</button>
    </div>
    <div data-page-blocks></div>
  </div>
  <div class="honest">
    <strong>What this extracts is the searchable text layer already inside the PDF</strong> -
    the invisible text that makes a document selectable. It is not true OCR of images.
    If a page shows no text, it is likely a pure scan; real OCR (tesseract) is a planned
    upgrade for a future version.
  </div>
</section>

<style>
  .results h3 {
    margin: 0 0 0.3rem;
  }
  .page-block {
    margin-top: 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.9rem;
    background: var(--bg);
  }
  .page-block pre {
    margin: 0.4rem 0 0;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: var(--mono);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .empty-page {
    color: var(--muted);
    font-style: italic;
  }
  .honest {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 1rem;
    max-width: 52ch;
  }
</style>

<script>
  import * as pdfjsLib from "pdfjs-dist/legacy/build/pdf.mjs";
  import { extractTextLayer } from "./tool.ts";
  import { readFileAsArrayBuffer, fileNameOf } from "@/lib/files";
  import { copyTextWithFeedback } from "@/lib/clipboard";

  pdfjsLib.GlobalWorkerOptions.workerSrc = new URL(
    "pdfjs-dist/legacy/build/pdf.worker.min.mjs",
    import.meta.url,
  ).toString();

  const zone = document.querySelector<HTMLDivElement>("[data-zone]");
  const input = document.querySelector<HTMLInputElement>("[data-input]");
  const runBtn = document.querySelector<HTMLButtonElement>("[data-run]")!;
  const out = document.querySelector<HTMLElement>("[data-out]")!;
  const results = document.querySelector<HTMLDivElement>("[data-results]");
  const copyAllBtn = document.querySelector<HTMLButtonElement>("[data-copy-all]");
  const pageBlocks = document.querySelector<HTMLDivElement>("[data-page-blocks]");
  if (!zone || !input || !runBtn || !out || !results || !copyAllBtn || !pageBlocks)
    throw new Error("mr ocr mount failed");

  const NO_TEXT = "No text layer found - this is a scanned image; true OCR is coming soon.";

  let file: File | null = null;
  let pages: string[] = [];

  function pick(f: File | undefined) {
    if (!f) return;
    file = f;
    runBtn.disabled = false;
    out.textContent = `${fileNameOf(f)} - ready to extract.`;
  }

  zone.addEventListener("click", () => input.click());
  input.addEventListener("change", () => pick(input.files?.[0]));
  zone.addEventListener("dragover", (e) => {
    e.preventDefault();
    zone.classList.add("drag");
  });
  zone.addEventListener("dragleave", () => zone.classList.remove("drag"));
  zone.addEventListener("drop", (e) => {
    e.preventDefault();
    zone.classList.remove("drag");
    pick(e.dataTransfer?.files?.[0]);
  });

  runBtn.addEventListener("click", async () => {
    if (!file) return;
    runBtn.disabled = true;
    out.textContent = "Extracting text layer…";
    try {
      pages = await extractTextLayer(await readFileAsArrayBuffer(file));
      out.textContent = "";
      pageBlocks.textContent = "";
      pages.forEach((text, i) => {
        const block = document.createElement("section");
        block.className = "page-block";
        const title = document.createElement("h3");
        title.textContent = `Page ${i + 1}`;
        block.append(title);
        if (text) {
          const pre = document.createElement("pre");
          pre.textContent = text;
          block.append(pre);
        } else {
          const empty = document.createElement("p");
          empty.className = "empty-page";
          empty.textContent = NO_TEXT;
          block.append(empty);
        }
        pageBlocks.append(block);
      });
      results.hidden = false;
    } catch (err) {
      out.textContent = "";
      const e = document.createElement("div");
      e.className = "error-text";
      e.textContent = err instanceof Error ? err.message : String(err);
      out.append(e);
    } finally {
      runBtn.disabled = false;
    }
  });

  copyAllBtn.addEventListener("click", () => {
    copyTextWithFeedback(
      pages.map((t, i) => (t ? `--- Page ${i + 1} ---\n${t}` : `--- Page ${i + 1} ---\n${NO_TEXT}`)).join("\n\n"),
      copyAllBtn,
    );
  });
</script>
