---
---
<section class="stage">
  <h2>DocuScrub</h2>
  <p class="muted" style="margin-top:-0.5rem;margin-bottom:1rem">Extract DOCX/RTF → clean Markdown/HTML (headings, tables, lists, links, images).</p>

  <div class="field">
    <span class="field-label">File</span>
    <div class="drop-zone" data-zone>
      <input type="file" class="input" style="display:none" accept=".docx,.rtf" data-file />
      <div class="dz-title">Drop DOCX or RTF file or click to browse</div>
      <div class="dz-hint">DOCX, RTF — max 50MB recommended</div>
    </div>
  </div>

  <div class="field" data-options style="display:none">
    <span class="field-label">Export Format</span>
    <select class="input" data-format>
      <option value="markdown">Markdown</option>
      <option value="html">HTML</option>
      <option value="text">Plain text</option>
    </select>
  </div>

  <div class="field" data-options style="display:none">
    <label class="input" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;padding:0.6rem 0.75rem">
      <input type="checkbox" data-extract-images checked> Extract images as data URLs
    </label>
  </div>

  <div class="actions">
    <button class="btn btn-primary" data-convert style="display:none">Extract</button>
    <button class="btn" data-download style="display:none">Download</button>
  </div>

  <div class="output-box" data-preview style="display:none;max-height:400px;overflow:auto"></div>

  <output class="output-box" data-out aria-live="polite"></output>
</section>

<script>
  import { parseDocx, formatBytes } from "./tool.ts";
  import { downloadText } from "@/lib/download";

  const zone = document.querySelector<HTMLElement>("[data-zone]")!;
  const fileInput = document.querySelector<HTMLInputElement>("[data-file]")!;
  const optionsDiv = document.querySelectorAll<HTMLElement>("[data-options]");
  const formatSel = document.querySelector<HTMLSelectElement>("[data-format]")!;
  const extractImagesCheckbox = document.querySelector<HTMLInputElement>("[data-extract-images]")!;
  const convertBtn = document.querySelector<HTMLButtonElement>("[data-convert]")!;
  const downloadBtn = document.querySelector<HTMLButtonElement>("[data-download]")!;
  const previewBox = document.querySelector<HTMLElement>("[data-preview]")!;
  const outBox = document.querySelector<HTMLElement>("[data-out]")!;

  let result: any = null;

  zone.addEventListener("click", () => fileInput.click());
  zone.addEventListener("dragover", (e) => { e.preventDefault(); zone.classList.add("drag"); });
  zone.addEventListener("dragleave", () => zone.classList.remove("drag"));
  zone.addEventListener("drop", (e) => {
    e.preventDefault();
    zone.classList.remove("drag");
    if (e.dataTransfer?.files.length) handleFile(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener("change", () => {
    if (fileInput.files?.[0]) handleFile(fileInput.files[0]);
    fileInput.value = "";
  });

  async function handleFile(file: File) {
    convertBtn.disabled = true;
    convertBtn.style.display = "none";
    downloadBtn.style.display = "none";
    previewBox.style.display = "none";
    optionsDiv.forEach(d => d.style.display = "none");

    outBox.textContent = "Reading file...";
    outBox.className = "output-box";

    try {
      const data = new Uint8Array(await file.arrayBuffer());
      result = await parseDocx(data);

      outBox.textContent = `Extracted: ${result.metadata.title || file.name} (${result.metadata.author || "Unknown author"})\n${result.html.split("<p>").length - 1} paragraphs, ${result.html.split("<h").length - 1} headings, ${result.images.size} images`;
      outBox.className = "output-box ok-text";

      optionsDiv.forEach(d => d.style.display = "");
      convertBtn.style.display = "";
      convertBtn.disabled = false;

      renderPreview();
    } catch (e) {
      outBox.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
      outBox.className = "output-box error-text";
    }
  }

  function renderPreview() {
    if (!result) return;
    previewBox.style.display = "block";
    previewBox.innerHTML = "";

    const meta = result.metadata;
    const div = document.createElement("div");
    div.style.fontSize = "0.9rem";
    div.innerHTML = `
      <strong>${escapeHtml(meta.title || "Untitled")}</strong><br>
      ${meta.author ? `By ${escapeHtml(meta.author)}<br>` : ""}
      ${meta.created ? `Created: ${escapeHtml(meta.created)}<br>` : ""}
      ${meta.modified ? `Modified: ${escapeHtml(meta.modified)}<br>` : ""}
      ${result.images.size} image${result.images.size !== 1 ? "s" : ""} found
    `;
    previewBox.appendChild(div);

    const format = formatSel.value;
    let content = format === "html" ? result.html : format === "markdown" ? result.markdown : result.text;

    const preview = document.createElement("div");
    preview.style.marginTop = "0.5rem";
    preview.style.maxHeight = "300px";
    preview.style.overflow = "auto";
    preview.style.fontFamily = "var(--mono)";
    preview.style.fontSize = "0.8rem";
    preview.style.background = "var(--bg)";
    preview.style.padding = "0.5rem";
    preview.style.borderRadius = "var(--radius-sm)";
    preview.style.whiteSpace = "pre-wrap";
    preview.textContent = content.slice(0, 3000);
    previewBox.appendChild(preview);
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, "&").replace(/</g, "<").replace(/>/g, ">").replace(/"/g, "\"").replace(/'/g, "'");
  }

  convertBtn.addEventListener("click", () => {
    if (!result) return;
    convertBtn.disabled = true;
    convertBtn.textContent = "Preparing...";
    outBox.textContent = "";
    outBox.className = "output-box";

    try {
      const format = formatSel.value;
      let content = format === "html" ? result.html : format === "markdown" ? result.markdown : result.text;
      const ext = format === "html" ? "html" : format === "markdown" ? "md" : "txt";

      downloadText(content, `document.${ext}`, format === "html" ? "text/html" : "text/plain");
      outBox.textContent = `Downloaded as ${ext.toUpperCase()}`;
      outBox.className = "output-box ok-text";
    } catch (e) {
      outBox.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
      outBox.className = "output-box error-text";
    } finally {
      convertBtn.disabled = false;
      convertBtn.textContent = "Extract";
    }
  });

  downloadBtn.addEventListener("click", () => {
    if (!result) return;
    const format = formatSel.value;
    let content = format === "html" ? result.html : format === "markdown" ? result.markdown : result.text;
    const ext = format === "html" ? "html" : format === "markdown" ? "md" : "txt";
    downloadText(content, `document.${ext}`, format === "html" ? "text/html" : "text/plain");
  });
</script>

<style>
  .drop-zone.drag { border-color: var(--accent); background: var(--accent-soft); }
</style>