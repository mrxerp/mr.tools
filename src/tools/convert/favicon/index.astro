---
---
<section class="stage">
  <h2>FaviconKit</h2>
  <p class="muted" style="margin-top:-0.5rem;margin-bottom:1rem">Generate complete favicon set (ico, PNGs, maskable, apple-touch-icon) + manifest from one image.</p>

  <div class="field">
    <span class="field-label">Source Image</span>
    <div class="drop-zone" data-zone>
      <input type="file" class="input" style="display:none" accept="image/*" data-file />
      <div class="dz-title">Drop image or click to browse</div>
      <div class="dz-hint">PNG, JPG, SVG — square recommended, max 10MB</div>
    </div>
  </div>

  <div class="field" data-options style="display:none">
    <span class="field-label">App Name</span>
    <input class="input" placeholder="My App" data-app-name />
  </div>

  <div class="field" data-options style="display:none">
    <span class="field-label">Background Color</span>
    <input type="color" class="input" value="#ffffff" data-bg-color style="height:2.5rem;padding:0.2rem" />
  </div>

  <div class="field" data-options style="display:none">
    <span class="field-label">Theme Color</span>
    <input type="color" class="input" value="#5a5bd9" data-theme-color style="height:2.5rem;padding:0.2rem" />
  </div>

  <div class="field" data-options style="display:none">
    <label class="input" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;padding:0.6rem 0.75rem">
      <input type="checkbox" data-maskable> Generate maskable icons (PWA)
    </label>
  </div>

  <div class="actions">
    <button class="btn btn-primary" data-generate style="display:none">Generate Favicons</button>
    <button class="btn" data-download style="display:none">Download ZIP</button>
  </div>

  <div class="output-box" data-preview style="display:none;max-height:400px;overflow:auto"></div>

  <output class="output-box" data-out aria-live="polite"></output>
</section>

<script>
  import { generateFavicons, formatBytes } from "./tool.ts";
  import { downloadArrayBuffer } from "@/lib/download";

  const zone = document.querySelector<HTMLElement>("[data-zone]")!;
  const fileInput = document.querySelector<HTMLInputElement>("[data-file]")!;
  const optionsDiv = document.querySelectorAll<HTMLElement>("[data-options]");
  const appNameInput = document.querySelector<HTMLInputElement>("[data-app-name]")!;
  const bgColorInput = document.querySelector<HTMLInputElement>("[data-bg-color]")!;
  const themeColorInput = document.querySelector<HTMLInputElement>("[data-theme-color]")!;
  const maskableCheckbox = document.querySelector<HTMLInputElement>("[data-maskable]")!;
  const generateBtn = document.querySelector<HTMLButtonElement>("[data-generate]")!;
  const downloadBtn = document.querySelector<HTMLButtonElement>("[data-download]")!;
  const previewBox = document.querySelector<HTMLElement>("[data-preview]")!;
  const outBox = document.querySelector<HTMLElement>("[data-out]")!;

  let imageData: Uint8Array | null = null;
  let imageMimeType: string = "";
  let result: any = null;

  zone.addEventListener("click", () => fileInput.click());
  zone.addEventListener("dragover", (e) => { e.preventDefault(); zone.classList.add("drag"); });
  zone.addEventListener("dragleave", () => zone.classList.remove("drag"));
  zone.addEventListener("drop", (e) => {
    e.preventDefault();
    zone.classList.remove("drag");
    if (e.dataTransfer?.files.length) handleFile(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener("change", () => {
    if (fileInput.files?.[0]) handleFile(fileInput.files[0]);
    fileInput.value = "";
  });

  async function handleFile(file: File) {
    generateBtn.disabled = true;
    generateBtn.style.display = "none";
    downloadBtn.style.display = "none";
    previewBox.style.display = "none";
    optionsDiv.forEach(d => d.style.display = "none");

    outBox.textContent = "Loading image...";
    outBox.className = "output-box";

    try {
      imageData = new Uint8Array(await file.arrayBuffer());
      imageMimeType = file.type;

      const img = new Image();
      img.src = URL.createObjectURL(new Blob([imageData.slice()], { type: imageMimeType }));
      await new Promise((resolve, reject) => { img.onload = resolve; img.onerror = reject; });

      outBox.textContent = `Loaded ${file.name} (${img.width}x${img.height}, ${formatBytes(imageData.length)})`;
      outBox.className = "output-box ok-text";

      optionsDiv.forEach(d => d.style.display = "");
      generateBtn.style.display = "";
      generateBtn.disabled = false;

      if (!appNameInput.value) appNameInput.value = file.name.replace(/\.[^.]+$/, "");
    } catch (e) {
      outBox.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
      outBox.className = "output-box error-text";
    }
  }

  generateBtn.addEventListener("click", async () => {
    if (!imageData) return;
    generateBtn.disabled = true;
    generateBtn.textContent = "Generating...";
    outBox.textContent = "";
    outBox.className = "output-box";

    try {
      const options = {
        appName: appNameInput.value,
        shortName: appNameInput.value.slice(0, 12),
        backgroundColor: bgColorInput.value,
        themeColor: themeColorInput.value,
        maskable: maskableCheckbox.checked,
      };

      result = await generateFavicons(imageData, imageMimeType, options);

      outBox.textContent = `Generated ${result.icons.length} icons + manifest (${formatBytes(JSON.stringify(result.manifest).length)}). Ready to download.`;
      outBox.className = "output-box ok-text";
      downloadBtn.style.display = "";

      renderPreview();
    } catch (e) {
      outBox.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
      outBox.className = "output-box error-text";
    } finally {
      generateBtn.disabled = false;
      generateBtn.textContent = "Generate Favicons";
    }
  });

  function renderPreview() {
    if (!result) return;
    previewBox.style.display = "block";
    previewBox.innerHTML = "";

    const div = document.createElement("div");
    div.style.fontSize = "0.9rem";
    div.innerHTML = `<strong>${result.icons.length} icons generated</strong>`;
    previewBox.appendChild(div);

    const grid = document.createElement("div");
    grid.style.display = "grid";
    grid.style.gridTemplateColumns = "repeat(auto-fill, minmax(80px, 1fr))";
    grid.style.gap = "0.5rem";
    grid.style.marginTop = "0.5rem";

    const keySizes = [16, 32, 48, 64, 128, 180, 192, 512];
    for (const size of keySizes) {
      const icon = result.icons.find((i: any) => i.size === size);
      if (!icon) continue;

      const cell = document.createElement("div");
      cell.style.textAlign = "center";
      cell.style.fontSize = "0.7rem";
      cell.style.fontFamily = "var(--mono)";

      const img = document.createElement("img");
      img.src = icon.dataUrl;
      img.width = size;
      img.height = size;
      img.style.border = "1px solid var(--border)";
      img.style.borderRadius = "4px";
      img.style.background = "var(--bg)";

      const label = document.createElement("div");
      label.style.marginTop = "0.2rem";
      label.textContent = `${size}×${size}`;

      cell.appendChild(img);
      cell.appendChild(label);
      grid.appendChild(cell);
    }

    previewBox.appendChild(grid);
  }

  downloadBtn.addEventListener("click", () => {
    if (!result) return;

    const zipData = createZip(result.icons, result.manifest, result.html);
    downloadArrayBuffer(zipData, "favicons.zip", "application/zip");
  });

  function createZip(icons: any[], manifest: string, html: string): Uint8Array {
    const encoder = new TextEncoder();
    const parts: Uint8Array[] = [];
    let offset = 0;

    const files: Record<string, Uint8Array> = {};

    for (const icon of icons) {
      files[icon.name] = new Uint8Array(new TextEncoder().encode(icon.dataUrl.split(",")[1]).length);
      const base64 = icon.dataUrl.split(",")[1];
      const binary = atob(base64);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      files[icon.name] = bytes;
    }

    files["manifest.json"] = encoder.encode(manifest);
    files["index.html"] = encoder.encode(`<!DOCTYPE html>\n<html>\n<head>\n${html}\n</head>\n<body></body>\n</html>`);

    for (const [name, data] of Object.entries(files)) {
      const nameBytes = encoder.encode(name);
      const header = new ArrayBuffer(30);
      const headerView = new DataView(header);
      headerView.setUint32(0, 0x04034b50, true);
      headerView.setUint16(4, 20, true);
      headerView.setUint16(6, 0, true);
      headerView.setUint16(8, 0, true);
      headerView.setUint16(10, 0, true);
      headerView.setUint16(12, 0, true);
      headerView.setUint32(14, 0, true);
      headerView.setUint32(16, data.length, true);
      headerView.setUint32(18, data.length, true);
      headerView.setUint16(20, nameBytes.length, true);
      headerView.setUint16(22, 0, true);

      parts.push(new Uint8Array(header));
      parts.push(nameBytes);
      parts.push(data);
      offset += 30 + nameBytes.length + data.length;
    }

    const centralDirParts: Uint8Array[] = [];
    let centralOffset = 0;

    for (const [name, data] of Object.entries(files)) {
      const nameBytes = encoder.encode(name);
      const centralHeader = new ArrayBuffer(46);
      const centralView = new DataView(centralHeader);
      centralView.setUint32(0, 0x02014b50, true);
      centralView.setUint16(4, 20, true);
      centralView.setUint16(6, 20, true);
      centralView.setUint16(8, 0, true);
      centralView.setUint16(10, 0, true);
      centralView.setUint16(12, 0, true);
      centralView.setUint16(14, 0, true);
      centralView.setUint32(16, 0, true);
      centralView.setUint32(20, data.length, true);
      centralView.setUint32(24, data.length, true);
      centralView.setUint16(28, nameBytes.length, true);
      centralView.setUint16(30, 0, true);
      centralView.setUint16(32, 0, true);
      centralView.setUint16(34, 0, true);
      centralView.setUint16(36, 0, true);
      centralView.setUint32(38, 0, true);
      centralView.setUint32(42, centralOffset, true);

      centralDirParts.push(new Uint8Array(centralHeader));
      centralDirParts.push(nameBytes);
      centralOffset += 46 + nameBytes.length;
    }

    const endOfCentralDir = new ArrayBuffer(22);
    const endView = new DataView(endOfCentralDir);
    endView.setUint32(0, 0x06054b50, true);
    endView.setUint16(4, 0, true);
    endView.setUint16(6, 0, true);
    endView.setUint16(8, Object.keys(files).length, true);
    endView.setUint16(10, Object.keys(files).length, true);
    endView.setUint32(12, centralOffset, true);
    endView.setUint32(16, offset, true);
    endView.setUint16(20, 0, true);

    const totalLength = parts.reduce((sum, p) => sum + p.length, 0) +
      centralDirParts.reduce((sum, p) => sum + p.length, 0) + 22;

    const result = new Uint8Array(totalLength);
    let pos = 0;
    for (const p of parts) { result.set(p, pos); pos += p.length; }
    for (const p of centralDirParts) { result.set(p, pos); pos += p.length; }
    result.set(new Uint8Array(endOfCentralDir), pos);

    return result;
  }
</script>

<style>
  .drop-zone.drag { border-color: var(--acent); background: var(--accent-soft); }
</style>