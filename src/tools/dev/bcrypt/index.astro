---
// mr.bcrypt - hash passwords with bcrypt and verify them against a hash.
---
<section class="stage">
  <h3>Hash</h3>
  <label class="field">
    <span class="field-label">Password</span>
    <input class="input" type="password" placeholder="Type a password to hash…" data-password />
  </label>
  <label class="field">
    <span class="field-label">Cost</span>
    <select class="input" data-cost>
      <option value="4">4</option>
      <option value="6">6</option>
      <option value="8">8</option>
      <option value="10" selected>10</option>
      <option value="12">12</option>
    </select>
  </label>
  <div class="actions">
    <button class="btn btn-primary" type="button" data-hash>Hash</button>
  </div>
  <output class="output-box" data-hash-out aria-live="polite"></output>

  <h3 style="margin-top: 2rem;">Verify</h3>
  <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
    <label class="field">
      <span class="field-label">Password</span>
      <input class="input" type="password" placeholder="Plaintext to check…" data-vpass />
    </label>
    <label class="field">
      <span class="field-label">Hash</span>
      <textarea class="input" rows="2" placeholder="$2b$10$…" data-vhash></textarea>
    </label>
  </div>
  <div class="actions">
    <button class="btn" type="button" data-verify>Verify</button>
    <span class="badge" data-verdict style="display: none;"></span>
  </div>
  <output class="output-box error-text" data-error style="display: none;"></output>
</section>

<script>
  import { hashPassword, verifyPassword } from "./tool.ts";

  const passwordEl = document.querySelector<HTMLInputElement>("[data-password]")!;
  const costEl = document.querySelector<HTMLSelectElement>("[data-cost]")!;
  const hashBtn = document.querySelector<HTMLButtonElement>("[data-hash]")!;
  const hashOut = document.querySelector<HTMLOutputElement>("[data-hash-out]")!;
  const vpassEl = document.querySelector<HTMLInputElement>("[data-vpass]")!;
  const vhashEl = document.querySelector<HTMLTextAreaElement>("[data-vhash]")!;
  const verifyBtn = document.querySelector<HTMLButtonElement>("[data-verify]")!;
  const verdictEl = document.querySelector<HTMLSpanElement>("[data-verdict]")!;
  const errorEl = document.querySelector<HTMLOutputElement>("[data-error]")!;
  if (!passwordEl || !costEl || !hashBtn || !hashOut || !vpassEl || !vhashEl || !verifyBtn || !verdictEl || !errorEl) {
    throw new Error("mr bcrypt mount failed");
  }

  import { copyTextWithFeedback } from "@/lib/clipboard";

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.style.display = "block";
  }

  function clearError() {
    errorEl.textContent = "";
    errorEl.style.display = "none";
  }

  hashBtn.addEventListener("click", async () => {
    clearError();
    verdictEl.style.display = "none";
    hashBtn.disabled = true;
    hashBtn.textContent = "Hashing…";
    try {
      const hash = await hashPassword(passwordEl.value, Number(costEl.value));
      hashOut.innerHTML = "";
      const row = document.createElement("div");
      row.style.display = "flex";
      row.style.alignItems = "center";
      row.style.justifyContent = "space-between";
      row.style.gap = "0.8rem";
      const text = document.createElement("span");
      text.textContent = hash;
      text.style.wordBreak = "break-all";
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "btn";
      btn.textContent = "Copy";
      btn.addEventListener("click", () => copyTextWithFeedback(hash, btn));
      row.append(text, btn);
      hashOut.appendChild(row);
      vhashEl.value = hash;
    } catch (err) {
      showError(err instanceof Error ? err.message : "Hashing failed");
    } finally {
      hashBtn.disabled = false;
      hashBtn.textContent = "Hash";
    }
  });

  verifyBtn.addEventListener("click", async () => {
    clearError();
    try {
      const ok = await verifyPassword(vpassEl.value, vhashEl.value);
      verdictEl.textContent = ok ? "Matches" : "Does not match";
      verdictEl.className = ok ? "badge badge-ok" : "badge";
      verdictEl.style.display = "inline-block";
    } catch (err) {
      verdictEl.style.display = "none";
      showError(err instanceof Error ? err.message : "Verification failed");
    }
  });
</script>
