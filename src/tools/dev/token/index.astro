---
// mr token - generate secure random tokens, all locally.
---
<section class="stage">
  <div class="field">
    <span class="field-label">Character sets</span>
    <div class="actions" style="gap: 1rem;">
      <label style="display: inline-flex; align-items: center; gap: 0.35rem;">
        <input type="checkbox" data-opt="lower" checked /> Lowercase
      </label>
      <label style="display: inline-flex; align-items: center; gap: 0.35rem;">
        <input type="checkbox" data-opt="upper" checked /> Uppercase
      </label>
      <label style="display: inline-flex; align-items: center; gap: 0.35rem;">
        <input type="checkbox" data-opt="digits" checked /> Digits
      </label>
      <label style="display: inline-flex; align-items: center; gap: 0.35rem;">
        <input type="checkbox" data-opt="symbols" /> Symbols
      </label>
    </div>
  </div>

  <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));">
    <label class="field">
      <span class="field-label">Length (1-256)</span>
      <input class="input mono" type="number" min="1" max="256" value="32" data-length />
    </label>
    <label class="field">
      <span class="field-label">Count (1-20)</span>
      <input class="input mono" type="number" min="1" max="20" value="3" data-count />
    </label>
  </div>

  <div class="actions">
    <button class="btn btn-primary" type="button" data-generate>Generate</button>
  </div>

  <output class="output-box" data-out aria-live="polite"></output>
</section>

<script>
  import { generateTokens, type CharsetOptions } from "./tool.ts";
  import { copyTextWithFeedback } from "@/lib/clipboard";

  const optsEls = new Map<string, HTMLInputElement>();
  document.querySelectorAll<HTMLInputElement>("[data-opt]").forEach((el) => {
    optsEls.set(el.dataset.opt ?? "", el);
  });
  const lengthEl = document.querySelector<HTMLInputElement>("[data-length]")!;
  const countEl = document.querySelector<HTMLInputElement>("[data-count]")!;
  const genBtn = document.querySelector<HTMLButtonElement>("[data-generate]")!;
  const out = document.querySelector<HTMLOutputElement>("[data-out]")!;

  if (!lengthEl || !countEl || !genBtn || !out || optsEls.size !== 4) {
    throw new Error("mr token mount failed");
  }

  function clampInt(v: number, min: number, max: number): number {
    return Math.min(max, Math.max(min, v));
  }

  function render() {
    const length = clampInt(Math.round(Number(lengthEl.value) || 0), 1, 256);
    const count = clampInt(Math.round(Number(countEl.value) || 0), 1, 20);
    const opts: CharsetOptions = {
      lower: optsEls.get("lower")!.checked,
      upper: optsEls.get("upper")!.checked,
      digits: optsEls.get("digits")!.checked,
      symbols: optsEls.get("symbols")!.checked,
    };
    out.innerHTML = "";
    let tokens: string[];
    try {
      tokens = generateTokens(length, opts, count);
    } catch (err) {
      const msg = document.createElement("div");
      msg.className = "error-text";
      msg.textContent = err instanceof Error ? err.message : "Generation failed";
      out.appendChild(msg);
      return;
    }
    for (const token of tokens) {
      const row = document.createElement("div");
      row.style.display = "flex";
      row.style.alignItems = "center";
      row.style.justifyContent = "space-between";
      row.style.gap = "0.8rem";
      const text = document.createElement("span");
      text.textContent = token;
      text.style.wordBreak = "break-all";
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "btn";
      btn.textContent = "Copy";
      btn.addEventListener("click", () => copyTextWithFeedback(token, btn));
      row.append(text, btn);
      out.appendChild(row);
    }
  }

  genBtn.addEventListener("click", render);
  render();
</script>
